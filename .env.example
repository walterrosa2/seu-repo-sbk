# ==========================================================================
# .env.example — modelo de variáveis de ambiente.
# Copie para ".env" e preencha com os valores REAIS.
# NUNCA comite o .env real (já está no .gitignore e no .dockerignore).
#
# Para o deploy on-premise (servidor Windows do cliente), gere o .env a
# partir do export do Railway:  railway variables --kv > .env
# e ajuste USE_NGROK=0 (acesso somente LAN).
# ==========================================================================

# --- Rede / API ---
API_HOST=0.0.0.0
API_PORT=8502

# --- OpenAI (agentes IA1 / IA2) ---
OPENAI_API_KEY=
OPENAI_ORG=
OPENAI_MODEL_IA1=gpt-4o
OPENAI_MODEL_IA2=gpt-4o

# --- SMTP (envio de e-mail / relatórios) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true

# --- Processamento IA2 ---
MAX_CHARS_LOTE_IA2=120000

# --- Diretórios / Retenção / Logs ---
DATA_DIR=execuções
RETAIN_DAYS=30
MASK_LOGS=true

# --- Ngrok (túnel externo) ---
# No deploy on-premise (LAN apenas) mantenha USE_NGROK=0.
USE_NGROK=0
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- AWS (Textract / S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_TEXTRACT_S3_BUCKET=
AWS_TEXTRACT_S3_PREFIX=uploads

<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<title>Relatório - {{ cnpj }}</title>
<style>
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #333;
    line-height: 1.5;
    margin: 40px;
    font-size: 12px;
  }
  h1, h2, h3 { color: #000; margin-top: 20px; margin-bottom: 10px; }
  h1 { border-bottom: 2px solid #333; padding-bottom: 10px; font-size: 18px; }
  h2 { font-size: 16px; margin-top: 30px; border-bottom: 1px solid #ccc; }
  h3 { font-size: 14px; font-weight: bold; }
  
  table { width: 100%; border-collapse: collapse; margin: 15px 0; font-size: 11px; }
  th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
  th { background-color: #f5f5f5; font-weight: bold; }
  
  blockquote {
    border-left: 3px solid #ccc; margin: 0; padding-left: 10px; color: #555;
  }
  
  .header { text-align: center; margin-bottom: 40px; }
  .header img { height: 40px; margin-bottom: 10px; }
  .meta { font-size: 10px; color: #666; text-align: right; border-top: 1px solid #eee; padding-top: 5px; margin-top: 50px; }
  
  /* Avoid page breaks inside elements */
  pre, blockquote, table { page-break-inside: avoid; }
  h1, h2, h3 { page-break-after: avoid; }
</style>
</head>
<body>
  <div class="header">
    <h1>Relatório de Análise de Crédito</h1>
    <div><strong>CNPJ:</strong> {{ cnpj }}</div>
    <div><strong>Data:</strong> {{ data_proc }}</div>
  </div>

  <div class="content">
    {{ conteudo | safe }}
  </div>

  <div class="meta">
    Gerado automaticamente por SBK Capital AI Pipeline.
  </div>
</body>
</html>

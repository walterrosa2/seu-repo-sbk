<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Relatório de Análise — {{ cnpj }}</title>
<style>
  :root {
    --bg-body: #ffffff;
    --bg-sidebar: #f0f2f6;
    --text-main: #31333f;
    --text-sidebar: #31333f;
    --accent: #ff4b4b; /* Streamlit Red/Pinkish */
    --blue-info-bg: #e6f3ff; /* Matching st.info approx */
    --blue-info-border: #29b5e8;
    --blue-info-text: #004280;
    --card-shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
  }
  
  * { box-sizing: border-box; }
  
  body {
    margin: 0;
    font-family: "Source Sans Pro", sans-serif;
    color: var(--text-main);
    display: flex;
    min-height: 100vh;
  }

  /* SIDEBAR */
  aside {
    width: 300px;
    background-color: var(--bg-sidebar);
    padding: 2rem 1rem;
    height: 100vh;
    overflow-y: auto;
    position: sticky;
    top: 0;
    border-right: 1px solid #dcdfe1;
    flex-shrink: 0;
  }
  
  .sidebar-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: #31333f;
  }
  
  .nav-group { margin-bottom: 1.5rem; }
  .nav-header {
    font-size: 0.85rem;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  
  .nav-item {
    display: block;
    padding: 0.5rem;
    border-radius: 0.25rem;
    text-decoration: none;
    color: inherit;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
    transition: background 0.2s;
  }
  .nav-item:hover { background-color: #e1e4e8; }
  
  .nav-subitem {
    display: block;
    padding: 0.4rem 0.5rem 0.4rem 1.5rem;
    font-size: 0.85rem;
    color: #555;
    text-decoration: none;
    border-radius: 0.25rem;
  }
  .nav-subitem:hover { background-color: #e1e4e8; color: #000; }

  /* MAIN CONTENT */
  main {
    flex: 1;
    padding: 3rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  h1 { font-size: 2.25rem; font-weight: 700; margin-bottom: 0.5rem; }
  h2 { font-size: 1.75rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem; border-bottom: 1px solid #eee; padding-bottom: 0.5rem;}
  h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  
  .meta-info {
    font-size: 0.9rem; color: #666; margin-bottom: 2rem;
  }
  
  /* METRICS */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .metric-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: var(--card-shadow);
    text-align: center;
    border: 1px solid #eee;
  }
  .metric-label { font-size: 0.85rem; color: #666; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.5px;}
  .metric-value { font-size: 1.8rem; font-weight: 700; color: #31333f; }
  
  /* CARDS GRID (Blocos) */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  
  .doc-card {
    border-radius: 0.5rem;
    padding: 1rem;
    color: #fff;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 90px;
    box-shadow: var(--card-shadow);
  }
  .doc-type { font-size: 0.75rem; opacity: 0.9; text-transform: uppercase; margin-bottom: 0.25rem; }
  .doc-name { font-size: 1rem; font-weight: 700; line-height: 1.2; }
  
  /* INFO BOX (Blue Highlight) */
  .st-info {
    background-color: var(--blue-info-bg);
    border: 1px solid rgba(41, 181, 232, 0.2);
    border-radius: 0.5rem;
    padding: 1rem;
    color: var(--text-main);
    margin-bottom: 1rem;
  }
  .st-info strong { color: #000; }
  
  /* Markdown content fixups */
  .st-info p { margin-top: 0; margin-bottom: 0.5em; }
  .st-info p:last-child { margin-bottom: 0; }
  .st-info ul { padding-left: 1.5rem; margin: 0.5em 0; }
  
  hr { border: 0; border-top: 1px solid #eee; margin: 2rem 0; }
  
  /* Print Optimization */
  @media print {
    aside { display: none; }
    main { padding: 0; max-width: 100%; }
    .metrics-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .doc-card { break-inside: avoid; border: 1px solid #aaa; color: #000 !important; background: #fff !important; }
    .doc-name, .doc-type { color: #000; }
  }
</style>
</head>
<body>

  <!-- SIDEBAR NAVIGATION -->
  <aside>
    <div class="sidebar-title">Relatório Analítico</div>
    
    <div class="nav-group">
      <div class="nav-header">Navegação</div>
      <a href="#cockpit" class="nav-item">📊 Visão Geral</a>
      {% for doc in document_blocks %}
        <a href="#block-{{ loop.index }}" class="nav-item">📄 {{ doc.clean_name }}</a>
        <div style="margin-left: 10px;">
          {% for part in doc.render_parts %}
            {% if part.type == 'subitem' %}
               <a href="#sub_{{ part.id }}" class="nav-subitem">🔸 {{ part.header | replace("Subitem =>", "") | trim }}</a>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </aside>

  <main>
    <div id="cockpit">
      <h1>Análise de Crédito</h1>
      <div class="meta-info">
        <strong>Cliente:</strong> {{ cnpj }} <br>
        <strong>Data:</strong> {{ data_proc }}
      </div>

      <!-- METRICS ROW -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-label">Risco</div>
          <div class="metric-value" style="color: {% if resumo.risco == 'Alto' %}red{% elif resumo.risco == 'Médio' %}orange{% else %}green{% endif %}">
            {{ resumo.risco|default("N/D") }}
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Limite Sugerido</div>
          <div class="metric-value">{{ resumo.limite|default("N/D") }}</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">RAROC</div>
          <div class="metric-value">{{ resumo.raroc|default("-") }}</div>
        </div>
      </div>

      <!-- CARDS GRID -->
      <h3>Blocos Analisados</h3>
      <div class="cards-grid">
        {% for doc in document_blocks %}
          <div class="doc-card" style="background-color: {{ doc.style_color }};">
             <div class="doc-type">{{ doc.meta.tipo_arquivo|default("DOC") }}</div>
             <div class="doc-name">{{ doc.clean_name }}</div>
          </div>
        {% endfor %}
      </div>
    </div>

    <hr>

    <!-- DETALHAMENTO -->
    <div id="detalhamento">
      <h2>Detalhamento da Análise</h2>
      
      {% for doc in document_blocks %}
        <div id="block-{{ loop.index }}" style="margin-bottom: 3rem;">
           <h3 style="color: #444;">{{ doc.clean_name }} <span style="font-size:0.8rem; font-weight:normal; color:#888;">[{{ doc.meta.tipo_arquivo }}]</span></h3>
           
           <!-- Content Parts -->
           {% for part in doc.render_parts %}
             {% if part.type == 'info' %}
                <div class="st-info">
                   {{ part.content | safe }}
                </div>
             {% elif part.type == 'subitem' %}
                <div id="sub_{{ part.id }}" class="st-info">
                   <div style="font-weight: bold; margin-bottom: 0.5rem;">{{ part.header }}</div>
                   <div>{{ part.content | safe }}</div>
                </div>
             {% endif %}
           {% endfor %}
        </div>
        <hr style="border-top: 1px dashed #eee;">
      {% endfor %}
    </div>

  </main>
</body>
</html>
